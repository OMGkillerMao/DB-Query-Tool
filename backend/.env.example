# LLM Configuration (supports OpenAI and compatible APIs)
# Required: API key for authentication (used by both OpenAI and compatible services)
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom LLM endpoint with /v1 suffix (e.g., http://localhost:11434/v1 for Ollama)
# Important: Include /v1 in the URL for OpenAI-compatible APIs
# Examples:
#   - Ollama: http://localhost:11434/v1
#   - vLLM: http://localhost:8000/v1
#   - New API gateway: http://10.11.203.232:3030/v1
# Leave empty to use OpenAI's default endpoint
LLM_BASE_URL=

# Optional: Model name to use (defaults to gpt-4o-mini for OpenAI)
# Examples: gpt-4o-mini, glm-4.7, llama3:8b, mixtral:8x7b
LLM_MODEL=gpt-4o-mini

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
